<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Created by Ray -->
<!-- 版本：1.4.0  /  build：5  /  2026-09-24  /  Ray -->
<!-- 主要解决问题：由 launchd 监听 auto_compress 真实目录，在文件原位置执行内容哈希去重和视觉无损替换。 -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ray.figma-export-lossless</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__SCRIPT_PATH__</string>
        <string>__CONFIG_PATH__</string>
    </array>

    <key>WatchPaths</key>
    <array>
        <string>__WATCH_DIR__</string>
    </array>

    <!-- 每 5 分钟兜底扫描一次，内容哈希缓存会保证同一内容不会重复压缩。 -->
    <key>StartInterval</key>
    <integer>300</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>ProcessType</key>
    <string>Background</string>

    <key>LowPriorityIO</key>
    <true/>

    <key>Nice</key>
    <integer>10</integer>

    <key>WorkingDirectory</key>
    <string>__WORKING_DIRECTORY__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>__HOME_DIRECTORY__</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>__STDOUT_LOG__</string>

    <key>StandardErrorPath</key>
    <string>__STDERR_LOG__</string>
</dict>
</plist>
