# Created by Ray
# 版本：1.4.0  /  build：5  /  2026-09-24  /  Ray
# 主要解决问题：分离发行默认配置和用户本地配置，支持安装时输入导出目录并自动识别 oxipng。

BASE_DIR="${HOME}/script/_figmaExport"
LOCAL_CONFIG_FILE="${BASE_DIR}/config.local.env"

# 安装器生成的用户配置优先于发行默认值，升级程序时不会覆盖导出目录和 oxipng 路径。
if [[ -f "${LOCAL_CONFIG_FILE}" ]]; then
    # shellcheck source=/dev/null
    source "${LOCAL_CONFIG_FILE}"
fi

# Figma 导出目录默认为工具内 auto_compress，安装时可以由用户输入其他绝对路径。
TARGET_DIR="${TARGET_DIR:-${BASE_DIR}/auto_compress}"

# 状态和日志与脚本放在同一工具目录，便于检查和整体迁移。
STATE_DIR="${STATE_DIR:-${BASE_DIR}/.state}"
LOG_DIR="${LOG_DIR:-${BASE_DIR}/logs}"

# 压缩器名称对应 compressors/<名称>.sh，可通过新增模块并修改此值完成替换。
COMPRESSOR_NAME="${COMPRESSOR_NAME:-oxipng}"

# 算法或参数变化时必须同步修改 ID，使相同内容可以按新规则重新处理一次。
COMPRESSOR_ID="${COMPRESSOR_ID:-oxipng-max-alpha-safe-v2}"

# oxipng 模块参数集中放在这里，便于在不修改主流程的情况下调整视觉无损策略。
OXIPNG_BIN="${OXIPNG_BIN:-}"
OXIPNG_OPT_LEVEL="${OXIPNG_OPT_LEVEL:-max}"
OXIPNG_THREADS="${OXIPNG_THREADS:-4}"
OXIPNG_TIMEOUT_SECONDS="${OXIPNG_TIMEOUT_SECONDS:-180}"

# 未写入本地配置时按常见 Homebrew 位置自动查找 oxipng。
if [[ -z "${OXIPNG_BIN}" ]]; then
    if command -v oxipng >/dev/null 2>&1; then
        OXIPNG_BIN="$(command -v oxipng)"
    elif [[ -x "/opt/homebrew/bin/oxipng" ]]; then
        OXIPNG_BIN="/opt/homebrew/bin/oxipng"
    elif [[ -x "/usr/local/bin/oxipng" ]]; then
        OXIPNG_BIN="/usr/local/bin/oxipng"
    fi
fi
